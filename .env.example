# Copy to .env and adjust. Every value can also be set as a real
# environment variable (which takes precedence over .env).

# SQLite for dev; any SQLAlchemy URL works (Postgres, MySQL, ...).
DATABASE_URL=sqlite:///./db.sqlite3

# JWT - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML training data (relative to the project root)
DATASET_PATH=static/dataset/lungcancer.csv

# Rate limit for POST /predict (slowapi syntax)
PREDICT_RATE_LIMIT=10/minute

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Premium conversion rate (1 USD in INR, as hardcoded in the original views.py)
INR_CONVERSION_RATE=75.0
